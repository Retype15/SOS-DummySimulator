	<!-- Tabs -->
	<sos.tab.simulator.title>模拟器</sos.tab.simulator.title>
	<sos.tab.simulator.tooltip>打开临床模拟器，在假人患者身上测试治疗和病症。</sos.tab.simulator.tooltip>

	<!-- Simulator -->
	<sos.sim.speedDropdown>x1 以上仍在开发中。\n在单人游戏中运行良好，但在多人游戏中完全不行。</sos.sim.speedDropdown>
	<sos.sim.play_tooltip>开始临床模拟。</sos.sim.play_tooltip>
	<sos.sim.pause_tooltip>暂停临床模拟。</sos.sim.pause_tooltip>
	<sos.sim.reset_tooltip>将患者的健康重置为初始状态。</sos.sim.reset_tooltip>
	<sos.sim.drop_tooltip>丢弃当前患者。</sos.sim.drop_tooltip>
	<sos.sim.set_max_tooltip>将此病症强度设置为最大值。</sos.sim.set_max_tooltip>
	<sos.sim.remove_tooltip>从患者身上移除这种病症。</sos.sim.remove_tooltip>
	<sos.sim.apply_item_tooltip>模拟在患者身上使用此物品以查看其效果。</sos.sim.apply_item_tooltip>
	<sos.sim.close_button>关闭此菜单。</sos.sim.close_button>

