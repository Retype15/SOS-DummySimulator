<Project>
    <PropertyGroup>
        <ProjectName>SOS.DummySimulator</ProjectName>
        <AssemblyName>DummySimulator</AssemblyName>
    </PropertyGroup>

    <Import Project="UserBuildData.props" Condition="Exists('UserBuildData.props')" />

    <PropertyGroup>
        <RefsPath Condition="'$(RefsPath)'==''">$(MSBuildThisFileDirectory)Refs</RefsPath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="SOS.SDK">
            <HintPath>$(RefsPath)\SOS.SDK.dll</HintPath>
        </Reference>
    </ItemGroup>

    <Import Project="CheckLocalization.targets" />
</Project>